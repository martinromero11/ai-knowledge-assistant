# Copy this file to .env and fill in a key. Without a key, the app still runs
# and returns the most relevant passages instead of a written answer.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings for semantic search (free tier at voyageai.com). Without this key,
# search is keyword-only.
VOYAGE_API_KEY=

# Optional settings (defaults shown)
# DATABASE_URL=sqlite:///./knowledge.db
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
# EMBEDDING_PROVIDER=voyage   (or openai, which uses OPENAI_API_KEY)
# EMBEDDING_MODEL=voyage-4-lite
# EMBEDDING_DIM=1024   (can't change after the database is created)
# SEMANTIC_MIN_SIMILARITY=0.3
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=5
# MAX_UPLOAD_MB=10
# LOG_LEVEL=INFO
